# 로컬 실행용 접속 정보의 형식. 이 파일을 .env 로 복사해 실제 값을 채운다(.env 는 커밋되지 않는다).
#
# 쓰이는 곳 두 군데:
#   1) docker compose  — compose 가 같은 디렉터리의 .env 를 자동으로 읽는다.
#   2) gradlew bootRun — local 프로파일의 spring.config.import 가 이 파일을 읽는다.
# 그래서 값에 따옴표를 쓰지 않는다(따옴표까지 값으로 들어간다).

# Redis — 워커와 같은 인스턴스를 봐야 한다. 로컬 Redis 는 redis-docker/docker-compose.yml 로 띄운다.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# PostgreSQL — 기동 시 Flyway 가 db/migration 의 스키마를 적용한다.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_tts_queuetts
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# API Key. local 프로파일에는 기본값이 있어 없어도 뜨지만, 실제로 쓰는 키를 여기서 고정한다.
QUEUETTS_ADMIN_API_KEY=QUEUETTS-LOCAL-ADMIN-000000000000000
QUEUETTS_CLIENT_API_KEY=QUEUETTS-LOCAL-CLIENT-000000000000000
