# Redis connection
# REDIS_URL takes priority when it is not empty.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_HEALTH_CHECK_INTERVAL_S=15
REDIS_CONNECT_TIMEOUT_S=5
REDIS_SOCKET_TIMEOUT_S=30

# Redis Streams contract
QUEUETTS_JOB_STREAM=tts:jobs
QUEUETTS_JOB_GROUP=tts-workers
QUEUETTS_RESULT_STREAM=tts:results
QUEUETTS_DEAD_STREAM=tts:jobs:dead

# Processor identity and lifecycle
QUEUETTS_WORKER_ID=tts-processor-local
QUEUETTS_CLAIM_MIN_IDLE_MS=120000
QUEUETTS_LEASE_REFRESH_S=30
# 한 번에 Redis 에서 가져와 batch 로 처리할 작업 수 (worker 소유; 첫 worker 가 tts:worker-config 로 seed, 이후 worker 는 동일해야 기동)
QUEUETTS_BATCH_SIZE=2
# 배치가 부족할 때 같은 Stream 에서 더 기다릴 최대 시간(ms). 0 이면 대기 없음
QUEUETTS_BATCH_WAIT_MS=200
# 할 일 없을 때 우선순위 큐를 다시 훑기 전 폴링 간격(ms)
QUEUETTS_POLL_INTERVAL_MS=50

# TTS model and runtime
QUEUETTS_ONNX_RUNTIME=cpu
QUEUETTS_ONNX_PROVIDERS=
QUEUETTS_ONNX_PRELOAD_DLLS=1
SUPERTONIC_MODEL=supertonic-3
SUPERTONIC_VOICE=Na-in-ae
SUPERTONIC_AUTO_DOWNLOAD=1
SUPERTONIC_CACHE_DIR=./model_cache/models/supertonic3
SUPERTONIC_INTRA_THREADS=4
SUPERTONIC_INTER_THREADS=1
HF_HOME=./model_cache/huggingface
