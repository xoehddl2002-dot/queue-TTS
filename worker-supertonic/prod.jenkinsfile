pipeline {
    agent any
    environment {
        PROFILE = 'prod'
        IMAGE_VERSION = '1.0'
        TYPE = 'cpu'

        IMAGE_URL = 'registry.example.com:5000/ai-tts-queuetts-model-worker'
    }
    stages {
        stage('Remove Docker history image') {
            steps {
                sh 'docker rmi $IMAGE_URL-$PROFILE:$IMAGE_VERSION || exit 0'
            }
        }
        stage('Docker build and Image') {
            steps {
                sh 'docker build -f ./Dockerfile.$TYPE -t $IMAGE_URL-$PROFILE:$IMAGE_VERSION .'
            }
        }
        stage('Docker push Image') {
            steps {
                sh 'docker push $IMAGE_URL-$PROFILE:$IMAGE_VERSION'
            }
        }
    }
}

