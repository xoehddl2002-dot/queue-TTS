# Redis connection
# REDIS_URL takes priority when it is not empty.
REDIS_URL=
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_HEALTH_CHECK_INTERVAL_S=15
REDIS_CONNECT_TIMEOUT_S=5
REDIS_SOCKET_TIMEOUT_S=30

# Redis Streams contract
# 잡/그룹/dead stream 은 Supertonic 워커(tts:*)와 반드시 달라야 한다.
# 결과 스트림만 공유한다 — Gateway 가 result stream 하나만 소비하기 때문.
QUEUETTS_JOB_STREAM=qwen:jobs
QUEUETTS_JOB_GROUP=qwen-workers
QUEUETTS_RESULT_STREAM=tts:results
QUEUETTS_DEAD_STREAM=qwen:jobs:dead

# Processor identity and lifecycle
QUEUETTS_WORKER_ID=qwen-processor-1
QUEUETTS_CLAIM_MIN_IDLE_MS=40000
QUEUETTS_LEASE_REFRESH_S=10
# 자기회귀 모델이라 한 잡이 길다. 배치로 묶으면 뒤 잡이 앞 잡의 추론을 통째로 기다린다.
QUEUETTS_BATCH_SIZE=1
QUEUETTS_BATCH_WAIT_MS=200
QUEUETTS_POLL_INTERVAL_MS=50

# Qwen model
# 클로닝은 Base 체크포인트에만 있다(화자 인코더가 Base 에만 들어 있다).
# CustomVoice/VoiceDesign 을 넣으면 워커가 기동 시점에 거절한다.
QWEN_MODEL_ID=Qwen/Qwen3-TTS-12Hz-1.7B-Base
QWEN_DEVICE_MAP=cuda:0
QWEN_DTYPE=bfloat16
QWEN_DEFAULT_LANGUAGE=Korean
QWEN_MAX_CHUNK_LENGTH=400

# 청크 앞뒤 무음 트리밍. Qwen 출력 특성을 파악하기 전에는 꺼 둔다.
QWEN_EDGE_TRIM=0
QWEN_EDGE_TRIM_KEEP_MS=200
QWEN_EDGE_TRIM_THRESHOLD=0.003
QWEN_OUTPUT_PADDING_MS=250

# 한국어 숫자/날짜/전화번호 정규화. Qwen 은 자체적으로 읽을 가능성이 높아 기본 꺼짐.
QUEUETTS_QWEN_TEXT_NORMALIZE=0

# Hugging Face 가중치 캐시 (컨테이너 안 경로. compose 가 볼륨으로 마운트한다)
HF_HOME=/app/model_cache/huggingface
